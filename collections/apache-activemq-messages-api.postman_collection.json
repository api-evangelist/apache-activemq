          "request": {
            "name": "Apache ActiveMQ Receive Message from Destination",
            "description": {
              "content": "Receives (consumes) a single message from the specified queue or topic. Supports session-based and clientId-based consumption, message selectors, and timeouts.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "message",
                ":destination"
              ],
              "host": [
                "{{baseUrl}}"
