              "item": [
                {
                  "name": "Apache ActiveMQ Read MBean Attribute via Jolokia",
                  "id": "9b36c243-81e7-496d-a770-52aa0a9adc4a",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "auth": {
                      "type": "basic",
                      "basic": [
                        {
                          "key": "username",
                          "value": "{{basicAuthUsername}}",
                          "type": "string"
                        },
                        {
                          "key": "password",
                          "value": "{{basicAuthPassword}}",
                          "type": "string"
                        }
                      ]
                    },
                    "method": "GET",
                    "header": [
                      {
                        "description": "(Required) Origin header required by Jolokia CORS protection.",
                        "key": "Origin",
                        "value": "<string>"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/jolokia/read/:mbean",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "jolokia",
                        "read",
                        ":mbean"
                      ],
                      "variable": [
                        {
                          "id": "040262d5-d8f5-4f21-931b-875d9b044284",
                          "key": "mbean",
                          "value": "<string>",
                          "description": "(Required) JMX ObjectName of the MBean to read, e.g., org.apache.activemq:type=Broker,brokerName=localhost"
                        },
                        {
                          "id": "078c402c-d759-4b4c-a050-158062a1d8af",
                          "key": "attribute",
                          "value": "<string>",
                          "description": "Optional attribute name to read from the MBean. If omitted, all attributes are returned."
                        }
                      ]
                    },
                    "description": "Reads JMX MBean attributes using the Jolokia HTTP bridge. Provides access to broker metrics such as total consumer count, queue depths, message counts, and other operational data."
                  },
