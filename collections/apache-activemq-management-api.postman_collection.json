      "item": [
        {
          "id": "dc2b5174-58b2-45f1-9ab7-839e93967160",
          "name": "Apache ActiveMQ Read MBean Attribute via Jolokia",
          "request": {
            "name": "Apache ActiveMQ Read MBean Attribute via Jolokia",
            "description": {
              "content": "Reads JMX MBean attributes using the Jolokia HTTP bridge. Provides access to broker metrics such as total consumer count, queue depths, message counts, and other operational data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "jolokia",
                "read",
                ":mbean"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "mbean",
                  "description": "(Required) JMX ObjectName of the MBean to read, e.g., org.apache.activemq:type=Broker,brokerName=localhost"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "attribute",
                  "description": "Optional attribute name to read from the MBean. If omitted, all attributes are returned."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Origin header required by Jolokia CORS protection.",
                "key": "Origin",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
          "response": [
