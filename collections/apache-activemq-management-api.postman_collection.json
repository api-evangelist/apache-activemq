    "_postman_id": "ff53fd3b-3476-4ca1-b331-98fdf23a0870",
    "name": "Apache ActiveMQ REST Management API",
    "description": "The Apache ActiveMQ REST API provides HTTP-based access to messaging operations, allowing clients to produce and consume messages from queues and topics without a native JMS client. It also exposes a Jolokia JMX-HTTP bridge for broker management and monitoring.\n\nContact Support:\n Name: Apache ActiveMQ Community",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
